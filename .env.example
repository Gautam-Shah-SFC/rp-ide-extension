# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Backend ingest endpoint that receives the { records: [...], source_type: "IDE_Extension" } payload.
RETROPER_UPLOAD_URL=

# Optional override for the login endpoint. Defaults to <RETROPER_UPLOAD_URL's origin>/api/v1/auth/login,
# which is the real Retroper endpoint - only set this if your backend uses a different host/path.
RETROPER_LOGIN_URL=

# No JWT here anymore. Auth is now done via the "Retroper: Login" command (email/password),
# and the resulting token is stored in VS Code's encrypted SecretStorage, not in this file.
