# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Optional. Direct backend ingest endpoint for the { records: [...], source_type: "IDE_Extension" }
# payload. Leave EMPTY unless DP has provisioned direct upload: with no value set, the extension
# still writes every captured turn to retroper-endpoint.jsonl (in the shared Retroper data dir)
# for the endpoint agent to forward to S3. When set, uploads go out with NO Authorization header -
# the mTLS gateway authenticates by the device client certificate presented in front of the process.
RETROPER_UPLOAD_URL=

# Optional override for the mTLS gateway identity endpoint. GET returns the certificate the gateway
# resolved for this device ({ authenticated, subject, issuer, serial, fingerprint, valid_from,
# valid_until }); the extension stamps that identity onto every captured record. Defaults to
# https://ns546939.ip-139-99-120.net:8443/whoami
RETROPER_IDENTITY_URL=

# The gateway's server cert currently names only "retroper-auth.test", so connecting by any other
# hostname fails TLS name verification. The extension still verifies the full chain against the
# pinned CA but also accepts a server cert whose CN/SAN is this name (default: retroper-auth.test).
# Leave this line commented. Set it to an empty value ONLY once the gateway cert is reissued to
# cover its real hostname - that turns strict hostname checking back on.
# RETROPER_IDENTITY_ALLOW_CN=

# There is no login, no password, and no token. The extension authenticates to the identity
# gateway with a per-device client certificate over mutual TLS. The certificate is NOT bundled in
# the .vsix - each machine supplies its own. By default the extension reads these from the shared
# Retroper data dir (%APPDATA%\Retroper\ on Windows, ~/Library/Application Support/Retroper/ on
# macOS); the env vars below only override those paths.
#
#   client cert (either form):
#     %APPDATA%\Retroper\client.p12            + %APPDATA%\Retroper\client.p12.pass  (password file)
#     %APPDATA%\Retroper\client-cert.pem       + %APPDATA%\Retroper\client-key.pem
#   CA chain (to verify the gateway):
#     %APPDATA%\Retroper\ca-chain.pem          OR  root_ca.crt (+ intermediate_ca.crt)
#
# RETROPER_CLIENT_PFX=            # path to a .p12/.pfx client certificate
# RETROPER_CLIENT_PFX_PASSWORD=   # its password (else a sibling <pfx>.pass file, else empty)
# RETROPER_CLIENT_CERT=           # path to a PEM client cert (alternative to the .p12)
# RETROPER_CLIENT_KEY=            # path to its PEM private key
# RETROPER_CA_BUNDLE=             # path to the CA chain PEM used to verify the gateway
#
# If no cert files are present, the extension (Windows only) looks in the certificate store for a
# cert whose issuer/subject contains this string and uses it via curl.exe (Schannel). Empty
# disables the store lookup. Default: Retroper Development CA
# RETROPER_CERT_STORE_ISSUER=
